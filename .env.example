# =============================================================================
# Copy to .env.local and fill in. PLACEHOLDERS ONLY — never commit a real value.
# The authoritative schema is src/lib/env.ts; this file mirrors it.
# =============================================================================

# =============================================================================
# Client-visible. NEXT_PUBLIC_ values are compiled into the browser bundle.
# Never add a secret here — see scripts/scan-client-bundle.mjs, which fails the
# build if one appears in a client asset.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Server only. Must never carry a NEXT_PUBLIC_ prefix.
# =============================================================================

# Bypasses RLS entirely. Only lib/db/service.ts may read it.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations (scripts/migrate.mjs) and Drizzle.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

LOG_LEVEL=info

# =============================================================================
# P2 — the import engine.
#
# No new variables. Uploads use the private `imports` storage bucket, which is
# created and policied by migration 0007 against the same Supabase project the
# variables above point at. Every limit (25 MB, the ~100,000-row spreadsheet
# cap, the 500-row chunk, the 24-hour staged-file lifetime) is a reviewed
# constant in src/lib/imports/constants.ts, deliberately not an environment
# knob: a limit that differs between environments is a limit nobody can reason
# about, and two of these are security boundaries.
# =============================================================================

# =============================================================================
# P3 — Amazon SES, sender configuration only.
#
# Optional as a set: with none of these present the application runs normally and
# the sender-domain pages report that the provider is not configured. With them
# present, domains can be provisioned and verified.
#
# Until live sending is deliberately enabled, attach docs/ses-iam-policy.json,
# which grants the configuration actions and explicitly DENIES ses:SendEmail. A
# credential that cannot send is a credential whose leak cannot send. The live
# policy (docs/ses-iam-policy-live.json) is a separate, later decision — see P5.
#
# Server-only, always. None of these may ever gain a NEXT_PUBLIC_ prefix;
# scripts/scan-client-bundle.mjs fails the build if a value reaches a client
# asset, and tests/sending-gates.test.ts pins the modules allowed to read them.
# =============================================================================
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only under temporary credentials (assumed role).
# AWS_SESSION_TOKEN=
# Optional. SESv2's identity APIs do not return an identity ARN, so
# sender_domains.ses_identity_arn is populated only when this is set. Nothing in
# P3 reads it; it is stored for operators.
# AWS_ACCOUNT_ID=

# =============================================================================
# P5 — the sending engine (OUTBOUND ONLY).
#
# Everything below is optional, and the defaults are the safe ones: with nothing
# set, EMAIL_SENDING_MODE is `disabled` and the worker does nothing at all.
#
# Recommended order: dry_run first (no credentials needed, nothing delivered),
# then live only after the sending domain is verified in SES, its DNS records
# are confirmed, and docs/ses-iam-policy-live.json is attached.
#
# This application never reads or changes MX records. Inbound mail for the
# domain stays with its existing provider.
# =============================================================================

# disabled | dry_run | live. `live` additionally requires every value marked
# [live] below, and an https NEXT_PUBLIC_APP_URL (unsubscribe links point at it).
# EMAIL_SENDING_MODE=disabled

# [live] Mandatory on every send: without it SES emits no events, and
# suppression, reconciliation and health all go dark.
# AWS_SES_CONFIGURATION_SET=

# [live] Authenticates the scheduler's calls to /api/internal/worker/tick
# (HMAC over timestamp + body). At least 32 characters. The same value goes in
# Supabase Vault as `worker_hmac_secret` (supabase/ops/p5_schedule.sql). With
# it unset, the worker endpoint refuses every request.
# WORKER_HMAC_SECRET=

# [live] Signs unsubscribe links. At least 32 characters. Also required to
# SCHEDULE any campaign that requires unsubscribe (the default), in every mode.
# Never rotate by replacing: old links must keep working, so add a v2 alongside.
# UNSUBSCRIBE_SECRET_V1=

# Operational policy. Documented defaults, not magic numbers.
# See ARCHITECTURE.md §14, §18 and docs/adr/0001, 0002, 0003.
# SEND_RATE_PER_MINUTE=60
# SEND_BATCH_MAX=50
# PROVIDER_SAFETY_FACTOR=0.8
# REAPER_CLAIM_TIMEOUT_MINUTES=15
# RECONCILE_GRACE_MINUTES=30
# UNCERTAIN_ATTEMPT_POLICY=hold
# SCHEDULE_GRACE_MINUTES=120

# P6 — SES event ingestion (bounces, complaints, delivery). Not used yet.
# AWS_SNS_TOPIC_ARN=
