# =============================================================================
# Client-visible. NEXT_PUBLIC_ values are compiled into the browser bundle.
# Never add a secret here — see scripts/scan-client-bundle.mjs, which fails the
# build if one appears in a client asset.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Server only. Must never carry a NEXT_PUBLIC_ prefix.
# =============================================================================

# Bypasses RLS entirely. Only lib/db/service.ts may read it.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for migrations (scripts/migrate.mjs) and Drizzle.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

LOG_LEVEL=info

# =============================================================================
# P2 — the import engine.
#
# No new variables. Uploads use the private `imports` storage bucket, which is
# created and policied by migration 0007 against the same Supabase project the
# variables above point at. Every limit (25 MB, the ~100,000-row spreadsheet
# cap, the 500-row chunk, the 24-hour staged-file lifetime) is a reviewed
# constant in src/lib/imports/constants.ts, deliberately not an environment
# knob: a limit that differs between environments is a limit nobody can reason
# about, and two of these are security boundaries.
# =============================================================================

# =============================================================================
# P3 — Amazon SES, sender configuration only.
#
# Optional as a set: with none of these present the application runs normally and
# the sender-domain pages report that the provider is not configured. With them
# present, domains can be provisioned and verified.
#
# The credential needs only the SES *configuration* actions. `ses:SendEmail` is
# deliberately not granted until P5 — see docs/ses-iam-policy.json, which is the
# policy to attach. A credential that cannot send is a credential whose leak
# cannot send.
#
# Server-only, always. None of these may ever gain a NEXT_PUBLIC_ prefix;
# scripts/scan-client-bundle.mjs fails the build if a value reaches a client
# asset, and tests/no-sending.test.ts pins the single module allowed to name them.
# =============================================================================
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only under temporary credentials (assumed role).
# AWS_SESSION_TOKEN=
# Optional. SESv2's identity APIs do not return an identity ARN, so
# sender_domains.ses_identity_arn is populated only when this is set. Nothing in
# P3 reads it; it is stored for operators.
# AWS_ACCOUNT_ID=

# =============================================================================
# Not used yet — listed so the operational surface is visible from the start.
# Introduced by the phase named against each.
# =============================================================================

# P5 — a configuration set is mandatory on every send: without it no events are
# emitted and suppression, health and analytics all go dark.
# AWS_SES_CONFIGURATION_SET=
# AWS_SNS_TOPIC_ARN=

# P5 — worker endpoint authentication (HMAC over timestamp + body).
# WORKER_HMAC_SECRET=

# P6 — unsubscribe token signing. Versioned: old links must keep working
# forever, so a retired key stays in the verify map long after it stops signing.
# UNSUBSCRIBE_SECRET_V1=

# P5 — operational policy. Documented constants, not magic numbers.
# See ARCHITECTURE.md §18.2 and docs/adr/0001, 0002.
# PROVIDER_SAFETY_FACTOR=0.8
# DEFAULT_WORKSPACE_DAILY_CAP=10000
# DEFAULT_WORKSPACE_RATE_PER_SECOND=5
# REAPER_CLAIM_TIMEOUT_MINUTES=15
# RECONCILE_GRACE_MINUTES=30
# UNCERTAIN_ATTEMPT_POLICY=hold
# SCHEDULE_GRACE_MINUTES=120
# QUOTA_MAX_AGE_MINUTES=30
